{
  "schemaVersion": 2,
  "id": "pptx-preview",
  "name": "PPTX Preview",
  "version": "0.3.0",
  "description": "无需安装 Office 即可静态预览 PPTX 的文本、图片、背景和表格；可选 LibreOffice 提供更准确的版式、翻页和缩放。不播放动画。",
  "enabled": true,
  "config": {
    "maxSlides": 80,
    "libreOfficePath": ""
  },
  "runtime": {
    "type": "python",
    "entry": "backend/main.py",
    "protocol": "jsonrpc-stdio",
    "permissions": {
      "workspaceRead": true,
      "tempArtifacts": true
    }
  },
  "views": [
    {
      "id": "document",
      "title": "幻灯片预览",
      "renderer": "document",
      "viewMode": "snapshot",
      "dataProfile": "heavy"
    }
  ],
  "fileHandlers": [
    {
      "id": "pptx-file",
      "label": "PowerPoint 预览",
      "extensions": [
        ".pptx"
      ],
      "viewId": "document"
    }
  ],
  "configSchema": {
    "title": "PPTX 预览设置",
    "sections": [
      {
        "id": "limits",
        "title": "预览限制",
        "fields": [
          {
            "key": "maxSlides",
            "label": "最多幻灯片",
            "type": "integer",
            "default": 80,
            "minimum": 1,
            "maximum": 300,
            "step": 1
          },
          {
            "key": "libreOfficePath",
            "label": "LibreOffice 路径（可选）",
            "type": "string",
            "default": "",
            "description": "留空自动查找；未安装时使用内置基础预览，无需额外软件。可选填 soffice.com（Windows）或 soffice 的完整路径以改善版式。",
            "placeholder": "C:\\Program Files\\LibreOffice\\program\\soffice.com"
          }
        ]
      }
    ]
  }
}
