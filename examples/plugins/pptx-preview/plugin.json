{
  "schemaVersion": 2,
  "id": "pptx-preview",
  "name": "PPTX Preview",
  "version": "0.2.0",
  "description": "使用 LibreOffice 将 PPTX 转换为静态页面，支持翻页与缩放，不播放动画。需要安装 LibreOffice（含 Impress）。",
  "enabled": true,
  "config": {
    "maxSlides": 80,
    "libreOfficePath": ""
  },
  "runtime": {
    "type": "python",
    "entry": "backend/main.py",
    "protocol": "jsonrpc-stdio",
    "permissions": {
      "workspaceRead": true,
      "tempArtifacts": true
    }
  },
  "views": [
    {
      "id": "document",
      "title": "幻灯片预览",
      "renderer": "document",
      "viewMode": "snapshot",
      "dataProfile": "light"
    }
  ],
  "fileHandlers": [
    {
      "id": "pptx-file",
      "label": "PowerPoint 预览",
      "extensions": [
        ".pptx"
      ],
      "viewId": "document"
    }
  ],
  "configSchema": {
    "title": "PPTX 预览设置",
    "sections": [
      {
        "id": "limits",
        "title": "预览限制",
        "fields": [
          {
            "key": "maxSlides",
            "label": "最多幻灯片",
            "type": "integer",
            "default": 80,
            "minimum": 1,
            "maximum": 300,
            "step": 1
          },
          {
            "key": "libreOfficePath",
            "label": "LibreOffice 路径",
            "type": "string",
            "default": "",
            "description": "留空自动查找；也可填写 soffice.com（Windows）或 soffice 的完整路径。",
            "placeholder": "C:\\Program Files\\LibreOffice\\program\\soffice.com"
          }
        ]
      }
    ]
  }
}
