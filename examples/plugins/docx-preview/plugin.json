{
  "schemaVersion": 2,
  "id": "docx-preview",
  "name": "DOCX Preview",
  "version": "0.3.0",
  "description": "按标题导航并预览 DOCX 的段落、图片与表格。预览 Word 97–2003 的 .doc 文件需要主机安装 LibreOffice Writer。",
  "enabled": true,
  "config": {},
  "runtime": {
    "type": "python",
    "entry": "backend/main.py",
    "protocol": "jsonrpc-stdio",
    "permissions": {
      "workspaceRead": true,
      "tempArtifacts": true
    },
    "limits": {
      "readBytes": 33554432,
      "artifactBytes": 33554432,
      "artifactCount": 128,
      "totalArtifactBytes": 268435456
    }
  },
  "views": [
    {
      "id": "document",
      "title": "文档预览",
      "renderer": "document",
      "viewMode": "session",
      "dataProfile": "light"
    }
  ],
  "fileHandlers": [
    {
      "id": "docx-file",
      "label": "Word 文档预览",
      "extensions": [
        ".docx",
        ".doc"
      ],
      "viewId": "document"
    }
  ]
}
