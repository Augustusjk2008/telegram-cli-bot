{
  "schemaVersion": 2,
  "id": "zip-preview",
  "name": "Archive Preview",
  "version": "0.2.0",
  "description": "预览常见压缩格式，并将内容解压到压缩包所在文件夹。",
  "enabled": true,
  "config": {
    "maxEntries": 2000,
    "maxExtractBytes": 268435456,
    "overwriteExisting": true
  },
  "runtime": {
    "type": "python",
    "entry": "backend/main.py",
    "protocol": "jsonrpc-stdio",
    "permissions": {
      "workspaceRead": true,
      "workspaceWrite": true
    },
    "limits": {
      "readBytes": 268435456,
      "writeBytes": 268435456
    }
  },
  "views": [
    {
      "id": "archive-tree",
      "title": "压缩包结构",
      "renderer": "tree",
      "viewMode": "session",
      "dataProfile": "light"
    }
  ],
  "fileHandlers": [
    {
        "id": "archive-file",
        "label": "压缩包预览",
      "extensions": [
        ".zip",
        ".rar",
        ".7z",
        ".gz",
        ".tgz",
        ".tar",
        ".bz2",
        ".tbz",
        ".tbz2",
        ".xz",
        ".txz",
        ".tar.gz",
        ".tar.bz2",
        ".tar.xz"
      ],
      "viewId": "archive-tree"
    }
  ],
  "configSchema": {
    "title": "压缩包预览设置",
    "sections": [
      {
        "id": "limits",
        "title": "预览限制",
        "fields": [
          {
            "key": "maxEntries",
            "label": "最多条目数",
            "type": "integer",
            "default": 2000,
            "minimum": 100,
            "maximum": 10000,
            "step": 1
          },
          {
            "key": "maxExtractBytes",
            "label": "最大解压大小（字节）",
            "type": "integer",
            "default": 268435456,
            "minimum": 1,
            "maximum": 268435456,
            "step": 1
          },
          {
            "key": "overwriteExisting",
            "label": "覆盖同名文件",
            "type": "boolean",
            "default": true
          }
        ]
      }
    ]
  }
}
