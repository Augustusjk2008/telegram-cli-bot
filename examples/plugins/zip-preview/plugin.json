{
  "schemaVersion": 2,
  "id": "zip-preview",
  "name": "ZIP Preview",
  "version": "0.1.0",
  "description": "不解压快速浏览 ZIP 压缩包目录结构。",
  "enabled": true,
  "config": {
    "maxEntries": 2000
  },
  "runtime": {
    "type": "python",
    "entry": "backend/main.py",
    "protocol": "jsonrpc-stdio",
    "permissions": {
      "workspaceRead": true
    }
  },
  "views": [
    {
      "id": "archive-tree",
      "title": "压缩包结构",
      "renderer": "tree",
      "viewMode": "snapshot",
      "dataProfile": "light"
    }
  ],
  "fileHandlers": [
    {
      "id": "zip-file",
      "label": "ZIP 结构预览",
      "extensions": [
        ".zip"
      ],
      "viewId": "archive-tree"
    }
  ],
  "configSchema": {
    "title": "ZIP 预览设置",
    "sections": [
      {
        "id": "limits",
        "title": "预览限制",
        "fields": [
          {
            "key": "maxEntries",
            "label": "最多条目数",
            "type": "integer",
            "default": 2000,
            "minimum": 100,
            "maximum": 10000,
            "step": 1
          }
        ]
      }
    ]
  }
}
