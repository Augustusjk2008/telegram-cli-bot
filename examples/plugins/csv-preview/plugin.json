{
  "schemaVersion": 2,
  "id": "csv-preview",
  "name": "CSV Preview",
  "version": "0.1.0",
  "description": "快速浏览 CSV 表格，支持搜索、排序和分页。",
  "enabled": true,
  "config": {
    "defaultPageSize": 50,
    "headerMode": "auto"
  },
  "configSchema": {
    "title": "CSV 预览设置",
    "sections": [
      {
        "id": "table",
        "title": "表格",
        "fields": [
          {
            "key": "defaultPageSize",
            "label": "默认页大小",
            "type": "integer",
            "default": 50,
            "minimum": 1,
            "maximum": 500,
            "step": 1
          },
          {
            "key": "headerMode",
            "label": "表头模式",
            "type": "select",
            "default": "auto",
            "options": [
              {"value": "auto", "label": "自动识别"},
              {"value": "header", "label": "有表头"},
              {"value": "no-header", "label": "无表头"}
            ]
          }
        ]
      }
    ]
  },
  "runtime": {
    "type": "python",
    "entry": "backend/main.py",
    "protocol": "jsonrpc-stdio",
    "permissions": {
      "workspaceRead": true
    },
    "limits": {
      "readBytes": 268435456
    }
  },
  "views": [
    {
      "id": "csv-table",
      "title": "CSV 预览",
      "renderer": "table",
      "viewMode": "session",
      "dataProfile": "heavy"
    }
  ],
  "fileHandlers": [
    {
      "id": "csv-file",
      "label": "CSV 预览",
      "extensions": [
        ".csv"
      ],
      "viewId": "csv-table"
    }
  ]
}
