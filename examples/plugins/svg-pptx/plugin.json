{
  "schemaVersion": 2,
  "id": "svg-pptx",
  "name": "SVG To PPTX",
  "version": "0.1.0",
  "description": "一个静态 SVG 导出一页 PPTX，文字可编辑，图形保留为图片层。",
  "enabled": true,
  "config": {
    "maxSourceBytes": 2097152,
    "conversionTimeoutSeconds": 45,
    "maxTextBoxes": 500,
    "maxLayers": 100,
    "renderMaxSide": 4096
  },
  "configSchema": {
    "title": "SVG PPTX Settings",
    "sections": [{
      "id": "limits",
      "title": "转换限制",
      "fields": [
        {"key": "maxSourceBytes", "label": "源文件字节上限", "type": "integer", "default": 2097152, "minimum": 1, "maximum": 33554432},
        {"key": "conversionTimeoutSeconds", "label": "转换超时秒数", "type": "integer", "default": 45, "minimum": 1, "maximum": 55},
        {"key": "maxTextBoxes", "label": "最大文本框数", "type": "integer", "default": 500, "minimum": 1, "maximum": 500},
        {"key": "maxLayers", "label": "最大图片层数", "type": "integer", "default": 100, "minimum": 1, "maximum": 100},
        {"key": "renderMaxSide", "label": "渲染最长边像素", "type": "integer", "default": 4096, "minimum": 1, "maximum": 4096}
      ]
    }]
  },
  "runtime": {
    "type": "python",
    "entry": "backend/main.py",
    "protocol": "jsonrpc-stdio",
    "permissions": {"workspaceRead": true, "tempArtifacts": true}
  },
  "views": [{"id": "svg-pptx", "title": "SVG 转 PPTX", "renderer": "table", "viewMode": "session", "dataProfile": "light"}],
  "fileHandlers": [{"id": "svg-source", "label": "SVG 转 PPTX", "extensions": [".svg"], "viewId": "svg-pptx"}]
}
