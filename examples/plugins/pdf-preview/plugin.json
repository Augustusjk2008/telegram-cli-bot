{
  "schemaVersion": 2,
  "id": "pdf-preview",
  "name": "PDF Preview",
  "version": "0.2.0",
  "description": "按原始版式预览 PDF 页面、字体、图片与图形，支持翻页、缩放和文字选择。",
  "enabled": true,
  "config": {},
  "runtime": {
    "type": "python",
    "entry": "backend/main.py",
    "protocol": "jsonrpc-stdio",
    "permissions": {
      "workspaceRead": true,
      "tempArtifacts": true
    }
  },
  "views": [
    {
      "id": "document",
      "title": "PDF 预览",
      "renderer": "document",
      "viewMode": "snapshot",
      "dataProfile": "light"
    }
  ],
  "fileHandlers": [
    {
      "id": "pdf-file",
      "label": "PDF 预览",
      "extensions": [
        ".pdf"
      ],
      "viewId": "document"
    }
  ]
}
