{
  "bots": [
    {
      "alias": "example-cli",
      "cli_type": "codex",
      "cli_path": "codex",
      "working_dir": "/path/to/project",
      "enabled": false
    },
    {
      "alias": "example-codex-server",
      "cli_type": "codex_server",
      "cli_path": "codex",
      "working_dir": "/path/to/project",
      "enabled": false,
      "supported_execution_modes": ["cli"],
      "default_execution_mode": "cli",
      "cli_params": {
        "codex_server": {
          "reasoning_effort": "xhigh"
        }
      }
    },
    {
      "alias": "test-expert",
      "cli_type": "codex",
      "cli_path": "codex",
      "working_dir": "/path/to/test-expert",
      "enabled": true,
      "cluster": {
        "enabled": true,
        "write_policy": "main_only",
        "max_parallel_agents": 3,
        "default_timeout_seconds": 1200,
        "model_tiers": {
          "low": "",
          "medium": "",
          "high": ""
        }
      }
    }
  ]
}
